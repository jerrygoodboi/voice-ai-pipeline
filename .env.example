# LLM Provider Selection: "ollama" (default) or "gemini"
LLM_PROVIDER=ollama

# Ollama / Qwen Settings (Used when LLM_PROVIDER=ollama)
# Can point to localhost:11434 or remote Tailscale host (e.g. http://100.x.y.z:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Gemini API Settings (Used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# VAD (Silero) Settings
VAD_DEVICE=cpu
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION=0.25
VAD_MIN_SILENCE_DURATION=0.5

# STT (Whisper) Settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS Settings (Engine: "edge", "piper", or "kokoro")
TTS_ENGINE=edge

# Edge TTS Settings
EDGE_VOICE=en-US-JennyNeural

# Piper TTS Settings
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_PATH=

# Kokoro TTS Settings
KOKORO_VOICE=af_heart
KOKORO_DEVICE=cpu

# Audio Settings
SAMPLE_RATE=16000

# Pipeline Mode: "standalone" (run all locally), "client" (low-spec laptop), "server" (remote host)
PIPELINE_MODE=standalone

# Tailscale / Remote Server settings (Used when PIPELINE_MODE=client)
# Set this on your laptop to your remote PC's Tailscale IP or MagicDNS hostname
REMOTE_SERVER_URL=http://100.x.y.z:8000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
REMOTE_REQUEST_TIMEOUT=60.0
